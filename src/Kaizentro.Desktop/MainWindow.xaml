<Window x:Class="Kaizentro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaizentro" Height="820" Width="1280" Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B3D91">
            <StackPanel Margin="24">
                <TextBlock Text="Kaizentro" Foreground="White" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Manufacturing Intelligence" Foreground="#D6E7FF" FontSize="13" Margin="0,4,0,32" />
                <TextBlock Text="Dashboard" Foreground="White" FontSize="16" Margin="0,8" />
                <TextBlock Text="Import Center" Foreground="#D6E7FF" FontSize="16" Margin="0,8" />
                <TextBlock Text="Value Stream Mapping" Foreground="#D6E7FF" FontSize="16" Margin="0,8" />
                <TextBlock Text="Capacity" Foreground="#D6E7FF" FontSize="16" Margin="0,8" />
                <TextBlock Text="Kaizens" Foreground="#D6E7FF" FontSize="16" Margin="0,8" />
                <TextBlock Text="Digital Twin" Foreground="#D6E7FF" FontSize="16" Margin="0,8" />
                <TextBlock Text="Reports" Foreground="#D6E7FF" FontSize="16" Margin="0,8" />

                <Border Background="#123F79" CornerRadius="8" Padding="12" Margin="0,36,0,0">
                    <StackPanel>
                        <TextBlock Text="Build 002" Foreground="White" FontWeight="Bold" />
                        <TextBlock Text="CSV import + generated VSM" Foreground="#D6E7FF" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32">
                <TextBlock Text="Kaizentro Enterprise - Build 002" FontSize="28" FontWeight="Bold" Foreground="#1B1B1B" />
                <TextBlock Text="Import SAP-style routing exports and generate a current-state value stream automatically." FontSize="15" Foreground="#555" Margin="0,4,0,18" />

                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="LoadCsvButton" Content="Import SAP / Excel CSV Routing" Padding="16,10" FontWeight="Bold" Click="LoadCsvButton_Click" />
                        <TextBlock Grid.Column="1" x:Name="ImportStatusText" Text="Sample 56-frame routing loaded. Import a CSV export to replace it." Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#555" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,24">
                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel><TextBlock Text="Takt Time" Foreground="#666"/><TextBlock x:Name="TaktText" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel><TextBlock Text="Lead Time" Foreground="#666"/><TextBlock x:Name="LeadTimeText" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel><TextBlock Text="VA Ratio" Foreground="#666"/><TextBlock x:Name="VaRatioText" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Margin="8" Padding="18">
                        <StackPanel><TextBlock Text="Open Kaizens" Foreground="#666"/><TextBlock x:Name="KaizenCountText" FontSize="26" FontWeight="Bold"/></StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Generated Current-State Value Stream" FontSize="22" FontWeight="Bold" Margin="0,8,0,8" />
                <TextBlock x:Name="VsmSummaryText" Foreground="#555" FontSize="14" Margin="0,0,0,12" />
                <Border Background="White" BorderBrush="#C9D8EA" BorderThickness="1" CornerRadius="10" Padding="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="ValueStreamCanvas" Height="245" Width="1000" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="Routing Operations" FontSize="22" FontWeight="Bold" Margin="0,24,0,12" />
                <ListView x:Name="ProcessList" Height="190" Background="White" />

                <TextBlock Text="Top AI Kaizen Opportunities" FontSize="22" FontWeight="Bold" Margin="0,24,0,12" />
                <ListView x:Name="OpportunityList" Height="220" Background="White" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
